:root {
  --cyan: #38f2ff;
  --red: #ff3860;
  --gold: #ffd166;
  --bg-dark: #0a0e14;
  --panel: rgba(10, 14, 20, 0.82);
  --panel-border: rgba(56, 242, 255, 0.35);
  font-family: 'Rajdhani', sans-serif;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--bg-dark);
  color: #e7f6ff;
  user-select: none;
}

#game-canvas {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.hidden { display: none !important; }

/* ================= MENU SCREEN ================= */
#menu-screen {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 20% 20%, rgba(56,242,255,0.12), transparent 40%),
    radial-gradient(circle at 80% 80%, rgba(255,56,96,0.12), transparent 40%),
    var(--bg-dark);
}

.menu-box {
  width: min(420px, 90vw);
  padding: 36px 32px;
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: 12px;
  box-shadow: 0 0 60px rgba(56,242,255,0.15);
  text-align: center;
}

.menu-box h1 {
  font-family: 'Orbitron', sans-serif;
  font-weight: 800;
  font-size: 30px;
  letter-spacing: 4px;
  margin: 0 0 6px;
  color: #fff;
}
.menu-box h1 span { color: var(--cyan); text-shadow: 0 0 18px var(--cyan); }

.subtitle {
  color: #9fb3c8;
  font-size: 14px;
  margin: 0 0 24px;
}

.menu-box input {
  width: 100%;
  padding: 12px 14px;
  margin-bottom: 12px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 6px;
  color: #fff;
  font-family: 'Rajdhani', sans-serif;
  font-size: 15px;
  outline: none;
}
.menu-box input:focus { border-color: var(--cyan); }

#join-btn {
  width: 100%;
  padding: 13px;
  margin-top: 6px;
  border: none;
  border-radius: 6px;
  background: linear-gradient(90deg, var(--cyan), #1a8fff);
  color: #001018;
  font-weight: 700;
  font-size: 16px;
  letter-spacing: 1px;
  cursor: pointer;
  transition: transform .12s ease, box-shadow .12s ease;
}
#join-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(56,242,255,0.35); }
#join-btn:active { transform: translateY(0); }

.hint { font-size: 12px; color: #7d92a6; margin-top: 18px; line-height: 1.6; }
.hint code { color: var(--cyan); }
.controls-hint { margin-top: 8px; color: #5a6d80; }

/* ================= HUD ================= */
#hud { position: fixed; inset: 0; z-index: 20; pointer-events: none; font-family: 'Rajdhani', sans-serif; }
#hud * { pointer-events: none; }
#hud button { pointer-events: auto; }

#crosshair {
  position: absolute; top: 50%; left: 50%; width: 18px; height: 18px;
  transform: translate(-50%, -50%);
}
#crosshair span {
  position: absolute; background: #fff; box-shadow: 0 0 4px rgba(0,0,0,0.6);
}
#crosshair span:nth-child(1) { top: 0; left: 8px; width: 2px; height: 6px; }
#crosshair span:nth-child(2) { bottom: 0; left: 8px; width: 2px; height: 6px; }
#crosshair span:nth-child(3) { left: 0; top: 8px; width: 6px; height: 2px; }
#crosshair span:nth-child(4) { right: 0; top: 8px; width: 6px; height: 2px; }

#phase-banner {
  position: absolute; top: 18px; left: 50%; transform: translateX(-50%);
  text-align: center; background: var(--panel); border: 1px solid var(--panel-border);
  border-radius: 8px; padding: 8px 22px; min-width: 160px;
}
#round-label { font-size: 11px; letter-spacing: 2px; color: #8fb0c4; }
#phase-label { font-family: 'Orbitron', sans-serif; font-size: 13px; letter-spacing: 2px; color: var(--gold); margin: 2px 0; }
#phase-timer { font-family: 'Orbitron', sans-serif; font-size: 22px; font-weight: 700; }

#scoreboard {
  position: absolute; top: 18px; left: 18px; display: flex; align-items: center; gap: 10px;
}
.score { background: var(--panel); border: 1px solid var(--panel-border); border-radius: 8px; padding: 8px 14px; text-align: center; }
.score span { display: block; font-family: 'Orbitron', sans-serif; font-size: 20px; font-weight: 700; }
.score.atk span { color: var(--red); }
.score.def span { color: var(--cyan); }
.score small { font-size: 9px; letter-spacing: 1px; color: #8fb0c4; }
#copy-link-btn {
  background: rgba(255,255,255,0.06); border: 1px solid var(--panel-border); color: #cfeeff;
  border-radius: 8px; padding: 8px 12px; cursor: pointer; font-size: 12px; font-family: 'Rajdhani', sans-serif;
}
#copy-link-btn:hover { background: rgba(56,242,255,0.15); }

#status-panel { position: absolute; bottom: 22px; left: 22px; width: 220px; }
#hp-row { display: flex; align-items: center; gap: 8px; }
#hp-bar-bg { flex: 1; height: 16px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden; border: 1px solid rgba(255,255,255,0.15); }
#hp-bar { height: 100%; width: 100%; background: linear-gradient(90deg, #ff3860, #ff9d3b); transition: width .15s ease; }
#hp-text { font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 16px; width: 34px; text-align: right; }
#credits-text { margin-top: 8px; font-family: 'Orbitron', sans-serif; font-size: 16px; color: var(--gold); }

#weapon-panel { position: absolute; bottom: 22px; right: 22px; text-align: right; }
#weapon-name { font-family: 'Orbitron', sans-serif; font-size: 15px; letter-spacing: 1px; color: #fff; }
#ammo-text { font-family: 'Orbitron', sans-serif; font-size: 26px; font-weight: 700; color: var(--cyan); }

#kill-feed {
  position: absolute; top: 90px; right: 18px; display: flex; flex-direction: column; gap: 4px;
  align-items: flex-end; max-width: 320px;
}
.kf-row {
  background: var(--panel); border: 1px solid var(--panel-border); border-radius: 6px;
  padding: 6px 12px; font-size: 13px; white-space: nowrap; animation: fadeIn .15s ease;
}
@keyframes fadeIn { from { opacity: 0; transform: translateX(10px); } to { opacity: 1; transform: translateX(0); } }

#action-progress {
  position: absolute; bottom: 90px; left: 50%; transform: translateX(-50%); width: 260px; text-align: center;
}
#action-label { font-size: 12px; letter-spacing: 2px; color: var(--gold); margin-bottom: 6px; }
#action-bar-bg { height: 10px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden; border: 1px solid rgba(255,255,255,0.15); }
#action-bar { height: 100%; width: 0%; background: var(--gold); transition: width .1s linear; }

#site-prompt {
  position: absolute; bottom: 130px; left: 50%; transform: translateX(-50%);
  background: var(--panel); border: 1px solid var(--panel-border); border-radius: 6px;
  padding: 6px 14px; font-size: 13px; color: #cfeeff;
}

#death-overlay {
  position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%);
  font-family: 'Orbitron', sans-serif; font-size: 20px; letter-spacing: 2px; color: var(--red);
  background: rgba(0,0,0,0.5); padding: 14px 28px; border-radius: 8px; border: 1px solid rgba(255,56,96,0.4);
}

.damage-flash {
  position: fixed; inset: 0; z-index: 30; pointer-events: none;
  background: radial-gradient(circle, transparent 40%, rgba(255,0,40,0.35) 100%);
  animation: damageFade .2s ease forwards;
}
@keyframes damageFade { from { opacity: 1; } to { opacity: 0; } }

#crosshair-hint {
  position: fixed; top: 50%; left: 50%; transform: translate(-50%, 60px);
  background: rgba(0,0,0,0.6); padding: 8px 16px; border-radius: 6px; font-size: 13px; z-index: 25;
}

/* ================= SHOP (BUY PHASE) ================= */
#shop {
  position: fixed; inset: 0; z-index: 40; display: flex; align-items: center; justify-content: center;
  background: rgba(4, 7, 12, 0.78); backdrop-filter: blur(3px);
}
.shop-panel {
  width: min(920px, 92vw); max-height: 82vh; overflow-y: auto;
  background: var(--panel); border: 1px solid var(--panel-border); border-radius: 12px; padding: 22px 26px;
}
.shop-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
.shop-header h2 { font-family: 'Orbitron', sans-serif; font-size: 18px; letter-spacing: 2px; margin: 0; }
#shop-credits { font-family: 'Orbitron', sans-serif; color: var(--gold); font-size: 18px; }

.shop-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.shop-col h3 { font-size: 12px; letter-spacing: 2px; color: #8fb0c4; margin: 0 0 10px; }

.weapon-card {
  width: 100%; display: block; text-align: left; margin-bottom: 10px;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px;
  padding: 10px 12px; cursor: pointer; color: #fff; font-family: 'Rajdhani', sans-serif;
  transition: border-color .12s ease, background .12s ease;
}
.weapon-card:hover { border-color: var(--cyan); background: rgba(56,242,255,0.08); }
.weapon-card.owned { border-color: var(--gold); background: rgba(255,209,102,0.1); }
.weapon-card.disabled { opacity: 0.35; cursor: not-allowed; }
.wc-name { font-weight: 700; font-size: 14px; }
.wc-stats { font-size: 11px; color: #9fb3c8; margin: 3px 0; }
.wc-price { font-size: 13px; color: var(--gold); font-weight: 700; }

#shop-close {
  margin-top: 18px; width: 100%; padding: 12px; border: none; border-radius: 8px;
  background: linear-gradient(90deg, var(--cyan), #1a8fff); color: #001018; font-weight: 700;
  cursor: pointer; font-size: 14px; letter-spacing: 1px;
}

@media (max-width: 720px) {
  .shop-grid { grid-template-columns: repeat(2, 1fr); }
}
